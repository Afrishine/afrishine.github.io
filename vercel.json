{
  "rewrites": [
    {
      "source": "/marketplace",
      "destination": "/"
    },
    {
      "source": "/academy",
      "destination": "/"
    },
    {
      "source": "/solution",
      "destination": "/"
    },
    {
      "source": "/talent",
      "destination": "/"
    },
    {
      "source": "/__/auth/:path*",
      "destination": "https://afrishine-hub.firebaseapp.com/__/auth/:path*"
    },
    {
      "source": "/share/:kind/:id",
      "destination": "/api/share?kind=:kind&id=:id"
    }
  ],
  "crons": [
    {
      "path": "/api/sec",
      "schedule": "0 22 * * *"
    }
  ]
}
