
{
  "redirects": [
    {
      "source": "/marketplace",
      "destination": "https://afrishine-marketplace.vercel.app",
      "permanent": false
    },
    {
      "source": "/marketplace/:path*",
      "destination": "https://afrishine-marketplace.vercel.app/:path*",
      "permanent": false
    },
    {
      "source": "/academy",
      "destination": "https://afrishine-academy.vercel.app",
      "permanent": false
    },
    {
      "source": "/academy/:path*",
      "destination": "https://afrishine-academy.vercel.app/:path*",
      "permanent": false
    },
    {
      "source": "/talent",
      "destination": "https://talent-hub.vercel.app",
      "permanent": false
    },
    {
      "source": "/talent/:path*",
      "destination": "https://talent-hub.vercel.app/:path*",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/__/auth/:path*",
      "destination": "https://afrishine-hub.firebaseapp.com/__/auth/:path*"
    },
    {
      "source": "/share/:kind/:id",
      "destination": "/api/share?kind=:kind&id=:id"
    }
  ]
}
