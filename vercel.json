{
  "rewrites": [
    { "source": "/terms", "destination": "/terms.html" },
    { "source": "/privacy", "destination": "/privacy.html" },
    { "source": "/marketplace", "destination": "/" },
    { "source": "/academy", "destination": "/" },
    { "source": "/solution", "destination": "/" },
    { "source": "/talent", "destination": "/" },
    { "source": "/__/auth/:path*", "destination": "https://afrishine-hub.firebaseapp.com/__/auth/:path*" },
    { "source": "/share/:kind/:id", "destination": "/api/share?kind=:kind&id=:id" }
  ],
  "headers": [
    { "source": "/sw.js", "headers": [
      { "key": "Cache-Control", "value": "no-cache, max-age=0, must-revalidate" },
      { "key": "Service-Worker-Allowed", "value": "/" } ] },
    { "source": "/manifest.json", "headers": [
      { "key": "Content-Type", "value": "application/manifest+json" },
      { "key": "Cache-Control", "value": "public, max-age=3600" } ] }
  ],
  "crons": [
    { "path": "/api/sec", "schedule": "0 22 * * *" }
  ]
}
